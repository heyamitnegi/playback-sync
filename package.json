{
  "name": "playback-sync",
  "version": "0.1.0",
  "description": "Synchronize video playback across multiple screens and devices. Shared clock, drift correction and schedule resolution as pure functions, with no dependencies.",
  "license": "MIT",
  "author": "heyamitnegi",
  "homepage": "https://github.com/heyamitnegi/playback-sync#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/heyamitnegi/playback-sync.git"
  },
  "bugs": {
    "url": "https://github.com/heyamitnegi/playback-sync/issues"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "sync",
    "synchronize",
    "synchronization",
    "sync-video",
    "video-sync",
    "synchronize-video",
    "video-synchronization",
    "synchronized-video",
    "sync-playback",
    "playback-sync",
    "video-playback-sync",
    "media-sync",
    "player-sync",
    "screen-sync",
    "multi-screen-sync",
    "multi-device-sync",
    "multiscreen",
    "video-wall",
    "digital-signage",
    "signage",
    "clock-sync",
    "time-sync",
    "timestamp-sync",
    "drift-correction",
    "lockstep",
    "ntp",
    "html5-video",
    "hls",
    "video",
    "playback"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean --sourcemap",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "demo": "npm run build && node examples/two-screens/server.mjs",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^5.0.3"
  }
}
